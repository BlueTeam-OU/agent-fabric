#!/usr/bin/env bash
# policies/githooks/pre-commit — `.agent-fabric/` is written by the
# fabric-coordinator ROLE. This refuses a commit that stages anything under
# it unless the agent's runtime binding holds that role right now.
#
# The role, not the login: an account is whoever is logged in, and a
# session becomes fabric-coordinator by binding the role from a login
# shell (`bin/fabric-role bind fabric-coordinator`) and launching. That
# binding is machine-local state
# (runtime/identity.py), so this is the one place the question "is the
# committer the coordinator" can be answered for real — CI sees only what
# the commit declares (the Fabric-Role trailer commit-msg adds, checked by
# policies/check_agent_fabric_dir_authority.sh as a tripwire).
#
# Installed per checkout by `git config core.hooksPath <agent-fabric>/
# policies/githooks` — bootstrap.sh does it for the agent-fabric checkout
# and for every registered working copy beside it. --no-verify bypasses
# it, which is a choice, not an accident.
set -uo pipefail
FABRIC_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"

# The decision records keep their own books (agent-fabric ADR-001): in
# agent-fabric itself, a commit that stages anything under docs/adr/ —
# renames out of it included — leaves them consistent in what it COMMITS:
# the staged tree is checked, not the working tree, which may hold what the
# commit leaves out. No pipe into grep -q (under pipefail a large staged
# list could end in SIGPIPE and skip the check). This hook also runs in
# every managed project, whose own docs/adr/ is that project's.
if [[ "$(readlink -f "$(git rev-parse --show-toplevel 2>/dev/null)")" == "$(readlink -f "$FABRIC_ROOT")" ]] \
   && ! git diff --cached --quiet --no-renames -- docs/adr/; then
    adr_tree="$(mktemp -d)" || { echo "pre-commit: cannot make a scratch directory to check the decision records" >&2; exit 1; }
    # The whole staged tree: a record's Evidence may cite any path in it.
    git checkout-index -a --prefix="$adr_tree/" || { rm -rf "$adr_tree"; echo "pre-commit: cannot materialize the staged tree to check the decision records" >&2; exit 1; }
    if ! adr_out="$(python3 "$FABRIC_ROOT/tools/fabric/adr.py" --root "$adr_tree" check 2>&1)"; then
        rm -rf "$adr_tree"
        printf 'pre-commit: the decision records in this commit are not consistent — not committed:\n%s\n' "$adr_out" >&2
        exit 1
    fi
    rm -rf "$adr_tree"
fi

# In agent-fabric ITSELF every commit is the coordinator's: the repository
# is read-only for every other role (CLAUDE.md, policies/AUTHORITY.md). In
# a managed project only .agent-fabric/ is. A merge changes only what
# differs from the clean three-way merge of its parents; a fold of main
# is no change of its own (guarded-change.sh).
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/guarded-change.sh"
guarded_change "$FABRIC_ROOT"
what="$guarded_what"; staged=("${guarded[@]}")
(( ${#staged[@]} )) || exit 0

owner_role="$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1]))["role_definitions"]["role"])
except Exception: print("fabric-coordinator")' "$FABRIC_ROOT/policies/authority.json" 2>/dev/null || echo fabric-coordinator)"
held="$(python3 "$FABRIC_ROOT/runtime/identity.py" --role 2>/dev/null || echo "")"

if [[ "$held" == "$owner_role" ]]; then
    exit 0
fi
# THE LOCALE CARVE-OUT. A locale's translations — identities/roles/<role>/
# locale/<suffix>/* — are authored by the holder of <role> whose login is
# named for <suffix> (language-culture-ge writes locale/ge/): the CEO's
# rule of 2026-09-17 that no Georgian in the fabric has any author but
# its holder, and the plane's read-only rule meeting it halfway. A commit
# that stages nothing but that subtree, from a session bound to that role
# on that login, passes; the commit-msg hook then records Fabric-Role:
# <role>, and CI admits it for that subtree alone
# (policies/check_agent_fabric_dir_authority.sh). Anything else staged
# beside it, another role, another suffix, or an amend (no staged
# paths to judge) is refused as before; a merge that folds main into
# such a branch is judged by what the branch adds over main. See
# policies/AUTHORITY.md.
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/locale-carve-out.sh"
mapfile -t own < <(locale_carve_out_paths)
if locale_carve_out_role "${own[@]}"; then
    login="$(id -un)"
    if [[ "$held" == "$locale_role" && ( "$login" == *-"$locale_suffix" || "$login" == "$locale_suffix" ) ]]; then
        exit 0
    fi
    cat >&2 <<MSG
pre-commit: this commit changes only identities/roles/$locale_role/locale/$locale_suffix/,
  which the holder of $locale_role named for $locale_suffix may commit — this session's
  binding holds ${held:-(no role bound)} on login $(id -un).
MSG
    exit 1
fi
# THE CONTRIBUTOR CARVE-OUT (ADR-018 §5 rule 8), in agent-fabric itself
# only: a role policies/authority.json names under `contributors` commits
# the paths of its entry, on its own contributor branch
# (<host>/<login>/for/<caller>/<what>), and fabric-coordinator folds and
# merges it; an entry with "merges": true also commits on its own
# <host>/<login>/<type>/<what> and merges its own pull request. contributors.py decides, here, in commit-msg and in CI. Only
# exit 0 admits; exit 1 is its own refusal, said; anything else (3, not a
# contributor; a fabric older than the module) falls to the refusal below.
contributors="$FABRIC_ROOT/tools/fabric/guards/contributors.py"
if [[ "$what" == "agent-fabric itself" && -n "$held" && -f "$contributors" ]]; then
    python3 "$contributors" hook "$FABRIC_ROOT" "$held"
    case $? in
        0) exit 0 ;;
        1) exit 1 ;;
    esac
fi
cat >&2 <<MSG
pre-commit: this commit changes $what, which only the $owner_role role writes.
  staged: $(printf '%s ' "${staged[@]:0:8}")$( (( ${#staged[@]} > 8 )) && echo "… (${#staged[@]} paths)")
  this agent's binding holds: ${held:-(no role bound)}

agent-fabric is read-only for every role but $owner_role; in a managed
project, .agent-fabric/ is. A change you need there is proposed to
$owner_role (a pull request, or a message). A wrong slice is corrected
at the memory it was drained from, or by a memory of the same class
carrying merge_target with the stale section's heading; the next drain
puts it in place — never a hand edit. If you hold the role, bind it from a login shell first —
bin/fabric-role bind $owner_role — and relaunch.
See agent-fabric policies/AUTHORITY.md.
MSG
exit 1
