#!/usr/bin/env bash
# policies/githooks/pre-commit — the fence at the keyboard: a commit that stages what the
# fabric-coordinator role guards (everything in agent-fabric itself, `.agent-fabric/` in a
# managed project) is refused unless the live binding holds the role or a carve-out admits it
# (the locale holder, a contributor), and the decision records are consistent in what it commits.
#
# A forwarder (ADR-040 §5 rule 1): the decision, and every reason for it, is
# tools/fabric/guards/commit_hooks.py on the fleet's pinned Python; git runs a hook by path, so
# the path stays. The hook's own real path says which fabric it serves (it may be reached
# through a link), so that is passed on. A commit hook that cannot reach its module REFUSES the
# commit in its own words (127): git reads a hook's silence as no objection. exec, so the
# module's parent is the process that runs the hook.
#
# Installed per checkout by `core.hooksPath <agent-fabric>/policies/githooks` (bootstrap does
# it). --no-verify bypasses it, which is a choice, not an accident.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "pre-commit: the fleet's pinned Python is not installed at $py, so this commit is refused; as root: /usr/bin/python3 $root/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$root/tools/fabric/guards/commit_hooks.py" pre-commit "$root" "$@"
