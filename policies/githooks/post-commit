#!/usr/bin/env bash
# policies/githooks/post-commit — attach the commit's timestamp proof as its
# note (agent-fabric ADR-057 §5 rule 4). The commit id does not exist while git
# signs, so fabric-sign keeps the proof keyed by the signature and this hook
# files it under refs/notes/fabric-ots once the commit is made.
#
# A post-commit hook cannot refuse a commit: a failure here is said and left
# to the pre-push hook, which attaches any proof still missing and refuses the
# push without one. It runs only where git signs through fabric-sign, so a
# working copy still on the shared key's wrapper is untouched.
set -uo pipefail
program="$(git config --get gpg.program 2>/dev/null)"
ssh_program="$(git config --get gpg.ssh.program 2>/dev/null)"
case "${program##*/}${ssh_program##*/}" in
    *fabric-sign*) ;;
    *) exit 0 ;;
esac
fabric-sign note HEAD || echo "post-commit: no proof note yet for HEAD; the pre-push hook attaches it" >&2
exit 0
