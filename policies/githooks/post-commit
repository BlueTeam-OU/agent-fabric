#!/usr/bin/env bash
# policies/githooks/post-commit — attach the commit's timestamp proof as its note (agent-fabric
# ADR-057 §5 rule 4), where git signs through fabric-sign; the decision is
# tools/fabric/guards/commit_hooks.py on the fleet's pinned Python.
#
# A forwarder (ADR-040 §5 rule 1) that, unlike pre-commit and commit-msg, does NOT fail closed:
# a post-commit hook cannot refuse a commit, and a failure here is said and left to the
# pre-push hook, which attaches any proof still missing and refuses the push without one. So a
# missing pin is said and the hook exits 0, as it does in every path.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "post-commit: the fleet's pinned Python is not installed at $py, so no proof note was filed; the pre-push hook attaches it; as root: /usr/bin/python3 $root/tools/fabric/python_pin.py install" >&2; exit 0; }
"$py" "$root/tools/fabric/guards/commit_hooks.py" post-commit "$root" "$@"
exit 0
