#!/usr/bin/env bash
# policies/githooks/commit-msg — refuses a commit message carrying machine attribution BEFORE
# it becomes a commit, repeats the fence pre-commit holds (the Fabric-Role trailer it writes is
# what CI reads), stamps the Kind: trailer, and holds a decision record's body edit to its
# Amendments row or an ADR-Editorial: trailer.
#
# A forwarder (ADR-040 §5 rule 1): the decision, and every reason for it, is
# tools/fabric/guards/commit_hooks.py on the fleet's pinned Python; git runs a hook by path, so
# the path stays. The hook's own real path says which fabric it serves (it may be reached
# through a link), so that is passed on. A commit hook that cannot reach its module REFUSES the
# commit in its own words (127): git reads a hook's silence as no objection. exec, so the
# module's parent is the git that runs the hook (commit_kind.py reads its argv).
#
# Installed per checkout by `core.hooksPath <agent-fabric>/policies/githooks`. --no-verify
# bypasses it, which is a choice, not an accident.
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "commit-msg: the fleet's pinned Python is not installed at $py, so this commit is refused; as root: /usr/bin/python3 $root/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$root/tools/fabric/guards/commit_hooks.py" commit-msg "$root" "$@"
