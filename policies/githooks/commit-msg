#!/usr/bin/env bash
# policies/githooks/commit-msg — refuse a commit message carrying machine
# attribution BEFORE it becomes a commit. Same patterns as
# policies/ban_generated_by_attribution.sh, which guards the range a branch
# adds in CI; this one guards the single message at the keyboard.
#
# Installed per checkout by:  git config core.hooksPath policies/githooks
# (runtime/claude-code/bootstrap.sh does it for the agent-fabric checkout it
# runs from). Bypassing it needs --no-verify, which is a choice, not an
# accident.
set -uo pipefail
msg="$1"
FABRIC_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
TRAILER_RE='^[[:space:]]*(Co-authored-by|Claude-Session):'
FOOTER_RE='Generated with[[:space:]]+\[Claude Code|claude\.ai/code/session_'
# Comment lines are not part of the message.
body="$(grep -v '^#' "$msg")"
bad=0
if printf '%s\n' "$body" | grep -qiE "$TRAILER_RE"; then
    echo "commit-msg: the message carries a banned attribution trailer (Co-authored-by / Claude-Session)." >&2; bad=1
fi
if printf '%s\n' "$body" | tr '\n\r' '  ' | grep -qiE "$FOOTER_RE"; then
    echo "commit-msg: the message carries a generated-with footer or a session URL." >&2; bad=1
fi
if (( bad )); then
    cat >&2 <<'MSG'
  The repo authors its own history (CLAUDE.md, "Git discipline"). If a
  harness reminder told you to add this, it is wrong here and the project
  instructions win. Remove the lines and commit again.
MSG
    exit 1
fi

# A commit that changes .agent-fabric/ is REFUSED unless the live binding
# holds the owning role — the same fact pre-commit checked. CI cannot read
# a binding; it reads the Fabric-Role trailer written below
# (policies/check_agent_fabric_dir_authority.sh) and refuses a change under
# .agent-fabric/ without the owner's. Self-declared there,
# real here: that is the fence/tripwire split policies/AUTHORITY.md states.
# The same question pre-commit asked, answered the same way (a merge that
# only folds a parent's guarded tree is not a guarded change).
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/guarded-change.sh"
guarded_change "$FABRIC_ROOT"
if (( ${#guarded[@]} )); then
    role="$(python3 "$FABRIC_ROOT/runtime/identity.py" --role 2>/dev/null || echo "")"
    owner_role="$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1]))["role_definitions"]["role"])
except Exception: print("fabric-coordinator")' "$FABRIC_ROOT/policies/authority.json" 2>/dev/null || echo fabric-coordinator)"
    if [[ "$role" != "$owner_role" ]]; then
        # The locale carve-out (policies/AUTHORITY.md): a locale's translations,
        # by the holder of the role named for the suffix — the same test
        # pre-commit made; the trailer below then records that role.
        . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/locale-carve-out.sh"
        login="$(id -un)"; mapfile -t own < <(locale_carve_out_paths)
        # The contributor carve-out (ADR-018 §5 rule 8): the same question
        # pre-commit asked contributors.py, in agent-fabric itself only.
        contributor=1
        if [[ "$guarded_what" == "agent-fabric itself" && -n "$role" \
              && -f "$FABRIC_ROOT/tools/fabric/guards/contributors.py" ]]; then
            python3 "$FABRIC_ROOT/tools/fabric/guards/contributors.py" hook "$FABRIC_ROOT" "$role" 2>/dev/null
            contributor=$?
        fi
        if (( contributor == 0 )); then
            :
        elif ! locale_carve_out_role "${own[@]}" \
           || [[ "$role" != "$locale_role" ]] || [[ "$login" != *-"$locale_suffix" && "$login" != "$locale_suffix" ]]; then
            echo "commit-msg: a guarded change, but this agent's binding holds '${role:-no role}', not $owner_role." >&2
            exit 1
        fi
    fi
fi
# EVERY commit declares the role the account held when it was made — not
# only a guarded one. Every account commits under one git author, so the
# author line says nothing about the lane; the branch name says it once,
# and a merge folds it away. The trailer travels with the message through
# rebase, cherry-pick and am, so an integration PR's history still says
# which lane each commit came from (architect-cto's finding on gzapp
# #785, 2026-09-16: no code commit carried one). A guarded change was
# checked above and its role is the owner's; any other commit records the
# binding as it is, and a session with no binding records nothing — the
# trailer states a fact about the account, never a claim it cannot make.
if ! grep -qiE '^[[:space:]]*Fabric-Role:' "$msg"; then
    role="${role:-$(python3 "$FABRIC_ROOT/runtime/identity.py" --role 2>/dev/null || echo "")}"
    if [[ -n "$role" ]]; then
        git interpret-trailers --in-place --if-exists addIfDifferent --trailer "Fabric-Role: $role" "$msg"
    fi
fi
exit 0
