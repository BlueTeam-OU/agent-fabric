#!/usr/bin/env bash
# runtime/hostexec/hostexec — run one command on a host the fabric operates,
# as the host's operator or as an account there. The path is the contract
# (fabric-host, moveto, provisioning and the control agent run it); the
# work, its contract and every reason for it are in tools/fabric/hostexec.py
# (ADR-040 §5 rule 4).
#
#   hostexec <host> [--as <login>] [--cwd <dir>] [--tty] -- <cmd> [args...]
#   hostexec --resolve <host>
#
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
# A host not yet provisioned has none: the refusal names the install command.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "hostexec: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
# Python ignores SIGPIPE at start-up; the module restores it before it execs.
exec "$py" -I "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../tools/fabric/hostexec.py" "$@"
