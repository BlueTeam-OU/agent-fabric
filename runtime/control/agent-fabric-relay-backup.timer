# runtime/control/agent-fabric-relay-backup.timer — every 6 hours (03, 09, 15, 21),
# for
# agent-fabric-relay-backup.service. Persistent: a host that was off at the
# hour runs it at the next start. The delay keeps the copy off the :00 mark,
# when the fleet's other timers fire. The hours start at 03 to stay off
# midnight, when the daily state backup (OnCalendar=daily, up to 1 h of delay)
# pushes every login's store to GitHub.
[Unit]
Description=agent-fabric: 6-hourly relay database backup

[Timer]
OnCalendar=*-*-* 03/6:00:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
