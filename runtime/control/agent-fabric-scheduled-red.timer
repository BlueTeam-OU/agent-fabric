# runtime/control/agent-fabric-scheduled-red.timer — once a day, for agent-fabric-scheduled-red.service. 07:00 UTC:
# the nightly is scheduled at 03:17 UTC (.github/workflows/stripped-nightly.yml), Actions starts a scheduled run
# late, and its job is bounded at 90 min, so by 07:00 the night's run has concluded. Clear of the state backup
# (midnight plus up to 1 h), the relay backup (03, 09, 15, 21 plus up to 15 min) and the drain (Monday 06:00 UTC plus
# up to 15 min). Persistent: a host that was off at the hour reads at its next start.
[Unit]
Description=agent-fabric: daily check of the stripped nightly's scheduled run

[Timer]
OnCalendar=*-*-* 07:00:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
