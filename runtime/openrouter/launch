#!/usr/bin/env bash
# runtime/openrouter/launch — launch this agent's Claude Code session, with
# the capability classes resolved from agent-fabric's routing files. The
# path is the contract (the README, moveto, fabric-fresh and the launcher's
# own relaunches run it); the work, its contract and every reason for it
# are in tools/fabric/launch.py (ADR-040 §5 rule 4).
#
#   runtime/openrouter/launch [claude args...]     # resolve, export, exec (broker)
#   runtime/openrouter/launch --provider anthropic # the same, on plain claude
#   runtime/openrouter/launch --print              # resolve and print; no exec
#
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
# The module is found by absolute path from this file, since a relative $0
# names nothing after the relaunch changes directory.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "launch: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" -I "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../tools/fabric/launch.py" "$@"
