#!/usr/bin/env bash
# The operator key's forced command (agent-fabric ADR-048 §5 rules 3-4):
# sshd runs this, whatever the client asked, as the account the key is for,
# with the request in SSH_ORIGINAL_COMMAND. It accepts one of four exact
# words and enters the account through moveto's installed `enter`.
#
# What this guarantees: the account's login files (~/.bash_profile,
# ~/.bashrc) run FIRST, in the login shell, before `enter`, and may replace
# it. enter-ssh and enter-ssh.conf are root-owned (never run from a
# checkout, which the account could rewrite), so all that pair guarantees is
# that the operator's key opens one of the four modes through that login
# shell. What then runs is the account's, as on the sudo path, so a pane
# shows what the account makes it show. The operator treats an agent's pane
# as that agent's, never as a trusted channel.
#
# Which `enter` it runs is the one line of enter-ssh.conf beside it
# (/usr/local/share/moveto/enter, moveto's install.sh). A file, not an
# environment variable: sshd passes the client's environment only where
# AcceptEnv allows, but a file the client cannot touch needs no such
# argument. A test installs a copy beside its own conf.
#
# Bash, not Python: a few lines that exec bash and then `enter` (bash), and
# it must work in an account before the pinned interpreter is there.
#
# The comparison is of the whole string against literal words, so a second
# word, a space, `;`, `$(...)` or a newline is simply not one of them;
# nothing here parses, and the client's text is never echoed. The word
# reaches `enter` as a positional parameter of a login shell, never inside
# its command string. The sudo path logs in too (enter is `#!/bin/bash -l`);
# over ssh the account is entered as itself, without sudo's environment
# reset, and login processing runs twice (enter-ssh's bash -lc, then
# enter's bash -l), which is harmless.
set -u
# Owner of enter-ssh.conf and of the enter it names. A constant, not a
# variable: tests/test_enter_ssh.py rewrites this line with sed in its
# installed copy, since a test cannot make files root-owned.
EXPECTED_OWNER_UID=0
case "${SSH_ORIGINAL_COMMAND-}" in
    --wait|--watch|--resume) mode=("$SSH_ORIGINAL_COMMAND") ;;
    shell) mode=() ;;
    *) echo "enter-ssh: refused; ask for exactly one of --wait, --watch, shell, --resume" >&2; exit 2 ;;
esac
conf="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/enter-ssh.conf"
enter="$(head -n 1 "$conf" 2>/dev/null)"
[[ "$enter" == /* && -x "$enter" ]] || { echo "enter-ssh: no installed enter named in $conf; nothing run" >&2; exit 1; }
# Refused unless root-owned and not group- or other-writable: a conf or enter
# the account could rewrite would make the fence above empty.
for f in "$conf" "$enter"; do
    read -r owner perm < <(stat -c '%u %a' "$f" 2>/dev/null) || owner=""
    if [[ "$owner" != "$EXPECTED_OWNER_UID" || $(( 8#${perm:-777} & 8#022 )) -ne 0 ]]; then
        echo "enter-ssh: $f is not owned by root and closed to group and others; nothing run" >&2; exit 1
    fi
done
# The pane's client, for the deck (j83): sshd's SSH_CLIENT is "<client ip>
# <client port> <server port>", and the client port is what the deck can read
# from its own ssh process, so the account's state names it, keyed by this
# process's pid: the exec below keeps the pid, so the harness the pane ends up
# running has it among its ancestors, and a reader finds the record by walking
# up from the session's `claude`. A convenience, never a gate: a record that
# cannot be written must not stop the pane, so every failure here is silent.
# A record of a pane that is gone (a dead pid) is pruned by the next entry.
record_client() {
    local dir file pid f
    [[ "${SSH_CLIENT-}" =~ ^[0-9a-fA-F.:]+\ [0-9]+\ [0-9]+$ ]] || return 0
    dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-fabric/agents/$(id -un)/ssh-clients"
    mkdir -p -m 700 "$dir" || return 0
    for f in "$dir"/*; do
        pid="${f##*/}"
        [[ "$pid" =~ ^[0-9]+$ ]] && ! kill -0 "$pid" 2>/dev/null && rm -f -- "$f"
    done
    printf '%s\n' "$SSH_CLIENT" > "$dir/.$$.tmp" && mv -f -- "$dir/.$$.tmp" "$dir/$$"
}
record_client 2>/dev/null || true
# enter's arguments are moveto's: the workspace and the pane's title.
# shellcheck disable=SC2016  # $0 and $@ are the inner shell's, by design
exec bash -lc 'exec "$0" "$@"' "$enter" "$HOME/projects" "$(id -un)" "${mode[@]}"
