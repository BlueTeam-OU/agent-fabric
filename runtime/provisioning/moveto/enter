#!/bin/bash -l
# Entered by `moveto`. argv: <dir> <title> [--wait|--resume|--watch]
#
# The mode is a fixed word moveto chooses and always the last argument:
# Fleet Deck reads it from this process's argv, never from the screen
# (docs/fleet-deck/tab-states.md). No person's text reaches this script.
#
# A separate file, not an inline `bash -lc '...'`: the inline form put the
# whole script on the process command line, and a terminal that titles from
# the running command then shows that instead of the session name.
#
# `-l` in the shebang keeps login processing (PATH from /etc/profile and
# ~/.bash_profile), which the inline `bash -lc` form also had, and is the
# reason this stub stays bash: it logs in, then hands over to the module that
# holds the work (moveto.py --enter, ADR-040 §5 rule 4), beside this file in
# share/moveto/ of an installed copy and in the repository.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "moveto: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" -I "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/moveto.py" --enter "$@"
