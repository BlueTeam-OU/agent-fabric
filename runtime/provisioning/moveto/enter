#!/bin/bash -l
# Entered by `moveto`. argv: <dir> <title>
#
# A separate file, not an inline `bash -lc '...'`: the inline form put the
# whole script on the process command line, and a terminal that titles from
# the running command then shows that instead of the session name.
#
# `-l` in the shebang keeps login processing (PATH from /etc/profile and
# ~/.bash_profile), which the inline `bash -lc` form also had.

cd "$1" || exit 1
export MOVETO_TITLE="$2"

# Entering an account is its refresh point. Three things, each best
# effort — offline or unenrolled, what is there stands, the shell still
# opens, and only a problem is worth one line:
#   1. the control plane: agent-fabric is read-only for every role but the
#      coordinator, so this clone can only be behind — fast-forward it;
#   2. bootstrap, which installs from that checkout (hooks, the agent
#      files, the skills, the workspace settings) and is idempotent;
#   3. the account's secrets, from its Doppler config into
#      ~/.config/agent-fabric/secrets.env, before the shell sources it.
fabric="$HOME/projects/agent-fabric"
if [ "$(git -C "$fabric" rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
    # git's first error line names the cause ("ssh: Could not resolve
    # hostname", "fatal: Not possible to fast-forward"); its last is often
    # boilerplate. The message used to guess between offline and a branch.
    if ! pull_err="$(timeout 30 git -C "$fabric" pull -q --ff-only origin main 2>&1)"; then
        reason="$(grep -m 1 -E '^(fatal|error|ssh):' <<<"$pull_err")"
        echo "moveto: agent-fabric not fast-forwarded (${reason:-${pull_err##*$'\n'}}); using it as is" >&2
    fi
    timeout 30 bash "$fabric/runtime/claude-code/bootstrap.sh" >/dev/null 2>&1         || echo "moveto: bootstrap did not complete; run it by hand" >&2
fi
fs="$fabric/bin/fabric-secrets"
if [ -x "$fs" ]; then
    timeout 20 "$fs" sync --quiet || true
fi

# Set the title NOW, before the first prompt. PROMPT_COMMAND alone leaves the
# terminal showing whatever it had while this was starting up.
# OSC 1 = icon/tab name, OSC 2 = window title. Explicit beats OSC 0, which
# means "both" and is honoured inconsistently.
printf '\033]1;%s\007\033]2;%s\007' "$MOVETO_TITLE" "$MOVETO_TITLE"

exec bash --rcfile /usr/local/share/moveto/rc -i
