#!/bin/bash -l
# Entered by `moveto`. argv: <dir> <title> [--wait|--resume|--watch]
#
# The mode is a fixed word moveto chooses and always the last argument:
# Fleet Deck reads it from this process's argv, never from the screen
# (docs/fleet-deck/tab-states.md). No person's text reaches this script.
#
# A separate file, not an inline `bash -lc '...'`: the inline form put the
# whole script on the process command line, and a terminal that titles from
# the running command then shows that instead of the session name.
#
# `-l` in the shebang keeps login processing (PATH from /etc/profile and
# ~/.bash_profile), which the inline `bash -lc` form also had.

cd "$1" || exit 1
export MOVETO_TITLE="$2"
mode="${3:-}"
case "$mode" in
    ''|--wait|--resume|--watch) ;;
    *) echo "moveto: unknown mode '$mode'; a plain shell" >&2; mode="" ;;
esac

# Set the title NOW, before the refresh and before any wait: a pane armed
# --wait sits here, and PROMPT_COMMAND alone would leave the terminal
# showing whatever it had while this was starting up.
# OSC 1 = icon/tab name, OSC 2 = window title. Explicit beats OSC 0, which
# means "both" and is honoured inconsistently.
printf '\033]1;%s\007\033]2;%s\007' "$MOVETO_TITLE" "$MOVETO_TITLE"

# --wait (Fleet Deck's dormant pane): one line, then one Enter does exactly
# --resume. The line comes BEFORE the refresh, so the pull, the bootstrap
# and the secrets are as fresh as the Enter, not as the pane. The line
# read is discarded whatever it holds; input that ends first is a plain
# shell, said.
if [ "$mode" = --wait ]; then
    printf '%s - Enter to activate\n' "$(id -un)"
    if IFS= read -r _; then
        mode=--resume
    else
        echo "moveto: input ended before Enter; a plain shell, nothing activated" >&2
        mode=""
    fi
fi

# Entering an account is its refresh point. Three things, each best
# effort — offline or unenrolled, what is there stands, the shell still
# opens, and only a problem is worth one line:
#   1. the control plane: agent-fabric is read-only for every role but the
#      coordinator, so this clone can only be behind — fast-forward it;
#   2. bootstrap, which installs from that checkout (hooks, the agent
#      files, the skills, the workspace settings) and is idempotent;
#   3. the account's secrets, from its own store into
#      ~/.config/agent-fabric/secrets.env, before the shell sources it.
fabric="$HOME/projects/agent-fabric"
if [ "$(git -C "$fabric" rev-parse --is-inside-work-tree 2>/dev/null)" = true ]; then
    # git's first error line names the cause ("ssh: Could not resolve
    # hostname", "fatal: Not possible to fast-forward"); its last is often
    # boilerplate. The message used to guess between offline and a branch.
    # A hung network writes nothing before the timeout: then the status says it.
    pull_err="$(timeout 30 git -C "$fabric" pull -q --ff-only origin main 2>&1)"; rc=$?
    if [ "$rc" -ne 0 ]; then
        reason="$(grep -m 1 -E '^(fatal|error|ssh):' <<<"$pull_err")"
        [ -n "$reason" ] || reason="${pull_err##*$'\n'}"
        if [ -z "$reason" ]; then
            if [ "$rc" = 124 ]; then reason="git pull timed out after 30 s"; else reason="git pull exit $rc"; fi
        fi
        echo "moveto: agent-fabric not fast-forwarded ($reason); using it as is" >&2
    else
        # --ff-only succeeds without a word on a clone that is AHEAD of
        # origin/main, so commits nobody merged stayed in force unsaid
        # (review of #80). A count git cannot give is said as unknown,
        # never read as zero.
        ahead="$(git -C "$fabric" rev-list --count origin/main..HEAD 2>/dev/null)" || ahead=""
        case "$ahead" in
            0) ;;
            ''|*[!0-9]*) echo "moveto: agent-fabric's commits beyond origin/main are unknown; using it as is" >&2 ;;
            *) echo "moveto: agent-fabric is $ahead commit(s) ahead of origin/main, which only a merge changes; using it as is" >&2 ;;
        esac
    fi
    timeout 30 bash "$fabric/runtime/claude-code/bootstrap.sh" >/dev/null 2>&1         || echo "moveto: bootstrap did not complete; run it by hand" >&2
fi
fs="$fabric/bin/fabric-secrets"
if [ -x "$fs" ]; then
    timeout 20 "$fs" sync --quiet || true
fi

# --resume (moveto <account> --resume, Fleet Deck's re-entry): the
# account's last session comes back first, as a child of this shell's
# start, through its own launcher (bin/fabric-resume), which says when it
# starts fresh instead, and refuses when a session already runs; when that
# session ends, the shell follows.
# --watch (the deck's status pane): bin/fabric-watch, read-only, until q;
# then the account's shell.
# A checkout older than either (its pull failed): the pane says nothing
# ran, never a silent plain shell.
case "$mode" in
    --resume) tool=fabric-resume ;;
    --watch) tool=fabric-watch ;;
    *) tool="" ;;
esac
if [ -n "$tool" ] && [ -x "$fabric/bin/$tool" ]; then
    "$fabric/bin/$tool" || echo "moveto: $tool exited $?" >&2
elif [ -n "$tool" ]; then
    echo "moveto: no $tool in $fabric; nothing run" >&2
fi

exec bash --rcfile /usr/local/share/moveto/rc -i
