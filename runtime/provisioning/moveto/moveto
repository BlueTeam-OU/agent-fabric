#!/usr/bin/env bash
# moveto — open a shell as another role account, in its workspace
# (~/projects — where a session is launched from), or in a named clone.
# The path is the contract (install.sh copies this file to /usr/local/bin,
# completion.bash and people run `moveto`); the work, its contract and
# every reason for it are in moveto.py (ADR-040 §5 rule 4).
#
#   moveto <account> [<clone>] [--print] | moveto [<account>] --list | moveto --help
#
# The module is beside this file in the repository and in share/moveto/ of
# an installed copy, which has no checkout behind it.
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "moveto: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
module="$here/moveto.py"
[[ -f "$module" ]] || module="$here/../share/moveto/moveto.py"
exec "$py" -I "$module" "$@"
