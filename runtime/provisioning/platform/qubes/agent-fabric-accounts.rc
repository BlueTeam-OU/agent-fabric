#!/usr/bin/env bash
# agent-fabric: re-create the role accounts at boot, and their linger.
#
# In a Qubes AppVM the root volume is a volatile snapshot of the template:
# /etc/passwd, /etc/shadow, /etc/group and /var/lib/systemd/linger are
# reset at every boot, while /home and /rw persist. The fifteen accounts
# provisioned on develop-qzapp had never met a reboot when this was found
# (2026-09-17): their homes would have survived, their logins not.
# Bind-dirs is not the answer — binding /etc/passwd makes it a mountpoint,
# and shadow-utils writes passwd+ then rename(2), which fails with EBUSY
# on a mountpoint, so every later useradd would break. This runs from
# /rw/config/rc.local.d (qubes-misc-post.service, after logind is up)
# — executed, not sourced, so bash is fine — and appends, verbatim, every
# snapshotted account record that the boot's
# /etc lacks; then enables linger for each so its user manager, and the
# control agent under it, come up without a login.
#
# The snapshot is /rw/config/agent-fabric/accounts/{passwd,shadow,group,
# gshadow,subuid,subgid}, one line per fabric account, written by
# runtime/provisioning/persist-accounts.sh at provisioning and on demand.
# A uid the template has meanwhile given to a system user is a collision:
# that account is skipped whole — none of its six lines — with a line on
# stderr, never appended over it. `members` (login:g1,g2) puts each
# re-added login back into the supplementary groups it had (the shared
# cache group the worker grants), in /etc/group and /etc/gshadow.
#
# One more thing the volatile root loses: the host-wide lease directory,
# /run/lock/agent-fabric (bin/fabric-lease, ADR-010), where
# the accounts take one flock per shared host resource — the backend
# suite's postgres, for one. 1777 like /tmp: every login creates its own
# lease files, none removes another's. On a persistent platform tmpfiles.d
# makes it; here it is made before anything else, so it exists even on a
# boot with no snapshot.
LEASES="${AGENT_FABRIC_LEASES:-/run/lock/agent-fabric}"
# The mode is the point: a 0755 fallback would leave every login unable to
# create its lease file, and /run is volatile, so nothing before the next
# boot could repair it — a failure here is said, never quiet.
install -d -m 1777 "$LEASES" 2>/dev/null || { mkdir -p "$LEASES" && chmod 1777 "$LEASES"; } || echo "agent-fabric-accounts: lease directory $LEASES not made 1777; fabric-lease will refuse every login until the next boot" >&2
S="${AGENT_FABRIC_ACCOUNTS_SNAPSHOT:-/rw/config/agent-fabric/accounts}"
ETC="${AGENT_FABRIC_ETC:-/etc}"
LOGINCTL="${AGENT_FABRIC_LOGINCTL:-loginctl}"
[ -d "$S" ] || exit 0
skipped=" "   # logins whose passwd line collided: none of their other lines go in either
skip() { case "$skipped" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
for f in passwd shadow group gshadow subuid subgid; do
    [ -f "$S/$f" ] || continue
    [ -f "$ETC/$f" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
        n="${line%%:*}"; [ -n "$n" ] || continue
        skip "$n" && continue
        grep -q "^$n:" "$ETC/$f" && continue
        if [ "$f" = passwd ]; then
            uid="$(printf '%s' "$line" | cut -d: -f3)"; gid="$(printf '%s' "$line" | cut -d: -f4)"
            if grep -q "^[^:]*:[^:]*:$uid:" "$ETC/passwd"; then
                printf 'agent-fabric-accounts: uid %s is taken in /etc/passwd; not re-adding %s (none of its records)\n' "$uid" "$n" >&2
                skipped="$skipped$n "
                continue
            fi
            # its primary group's gid taken by another name: the login would
            # come up in the template's group — skipped whole as well
            if grep -q "^[^:]*:[^:]*:$gid:" "$ETC/group" && ! grep -q "^$n:[^:]*:$gid:" "$ETC/group"; then
                printf 'agent-fabric-accounts: gid %s is taken in /etc/group by another group; not re-adding %s (none of its records)\n' "$gid" "$n" >&2
                skipped="$skipped$n "
                continue
            fi
        elif [ "$f" = group ]; then
            gid="$(printf '%s' "$line" | cut -d: -f3)"
            if grep -q "^[^:]*:[^:]*:$gid:" "$ETC/group"; then
                printf 'agent-fabric-accounts: gid %s is taken in /etc/group; not re-adding group %s\n' "$gid" "$n" >&2
                continue
            fi
        fi
        printf '%s\n' "$line" >> "$ETC/$f"
    done < "$S/$f"
done
# add_member <file> <group> <login>: the login into the group's member list, once
add_member() {
    [ -f "$1" ] || return 0
    grep -q "^$2:" "$1" || return 0
    # written beside and moved over: mode and owner copied first, so a kill
    # mid-way never leaves an empty group file for this boot
    cp -p "$1" "$1.agent-fabric" || return 0
    awk -F: -v OFS=: -v g="$2" -v u="$3" '$1 == g { n = split($4, m, ","); f = 0; for (i = 1; i <= n; i++) if (m[i] == u) f = 1; if (!f) $4 = ($4 == "" ? u : $4 "," u) } { print }' "$1" > "$1.agent-fabric" \
        && mv -f "$1.agent-fabric" "$1"
    rm -f "$1.agent-fabric"
}
if [ -f "$S/passwd" ]; then
    cut -d: -f1 "$S/passwd" | while IFS= read -r n; do
        [ -n "$n" ] || continue
        skip "$n" && continue
        grep -q "^$n:" "$ETC/passwd" || continue
        if [ -f "$S/members" ]; then
            grep "^$n:" "$S/members" | head -1 | cut -d: -f2 | tr ',' '\n' | while IFS= read -r g; do
                [ -n "$g" ] || continue
                add_member "$ETC/group" "$g" "$n"; add_member "$ETC/gshadow" "$g" "$n"
            done
        fi
        "$LOGINCTL" enable-linger "$n" 2>/dev/null
    done
fi
exit 0
