#!/usr/bin/env bash
# runtime/provisioning/secrets/fabric-secrets — an identity's secrets, from
# its own store (ADR-038), into the places the tools read them. Runs AS THE
# ACCOUNT. The path is the contract (bin/fabric-secrets, moveto, the control
# agent call it); the work is Python:
#
#   fabric-secrets sync|status …   tools/fabric/secrets_sync.py
#   fabric-secrets store …         tools/fabric/secret_store.py
#   fabric-secrets provision …     tools/fabric/store_provision.py (a parent fills its children's stores)
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)"
case "${1:-}" in
    store) shift; exec python3 "$ROOT/tools/fabric/secret_store.py" "$@" ;;
    provision) shift; exec python3 "$ROOT/tools/fabric/store_provision.py" "$@" ;;
esac
exec python3 "$ROOT/tools/fabric/secrets_sync.py" "$@"
