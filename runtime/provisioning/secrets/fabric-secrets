#!/usr/bin/env bash
# runtime/provisioning/secrets/fabric-secrets — an identity's secrets, from
# Doppler into the places the tools read them. Runs AS THE ACCOUNT.
#
#   fabric-secrets sync [--force] [--json] [--quiet]
#                                            pull this login's config, apply it
#                                            (--quiet: one line, only when
#                                            something is missing or failed)
#   fabric-secrets status [--json]           what is present, missing, applied
#   fabric-secrets store …                   the agent's own encrypted store
#                                            (tools/fabric/secret_store.py, ADR-038)
#
# The source is ~/.config/agent-fabric/secrets-source: `doppler` (the
# default, and what an absent file means) or `store`, this login's own
# pass-format repository. sync writes the same files from either, so no
# consumer knows which one it read (ADR-038 §5 rules 7-8).
#
# The record is the Doppler project `agent-fabric`, one config per Linux
# login: the branch config `<env>_<login>` under environment `agents`
# (`agents2`, … once one holds its ten configs — a Developer-plan project
# has four environments of ten configs, so the login is the branch, not
# the environment; enroll.sh records the name in the account's doppler
# config at scope /); the account holds a read-only service token for
# that config and nothing else. sync writes
#   ~/.config/agent-fabric/secrets.env   (0600) — the string secrets the
#                                        tools read from the environment:
#                                        OPENROUTER_API_KEY, GH_TOKEN,
#                                        CLAUDE_BRIDGE_AUTH_TOKEN
#   ~/.bashrc                            one marked line sourcing that file
#   ~/.gitconfig                         user.name/email, signing key and
#                                        program (strings; the key material
#                                        stays in the keyring)
#   ~/.ssh/id_ed25519(.pub)              only when absent; --force replaces
# and refuses when the config's AGENT_LOGIN is not this login — location
# and configuration never decide who an agent is, the login does.
#
# Nothing here prints a secret value: names, presence, ages and modes only.
# The project and config are passed explicitly on every doppler call;
# directory scopes in ~/.doppler play no part.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)"
if [[ "${1:-}" == store ]]; then shift; exec python3 "$ROOT/tools/fabric/secret_store.py" "$@"; fi
exec python3 - "$ROOT" "$@" <<'PY'
import json, os, pwd, shlex, socket, stat, subprocess, sys, time

ROOT = sys.argv[1]
ARGS = sys.argv[2:]
PROJECT = os.environ.get("AGENT_FABRIC_SECRETS_PROJECT", "agent-fabric")
LOGIN = pwd.getpwuid(os.getuid()).pw_name


def configured_config():
    """The config enroll.sh recorded in the account's doppler config at
    scope / (enclave.config) — a Developer-plan environment holds ten
    configs, so logins spill from `agents` into `agents2`, `agents3`, …
    and the account is told which one is its own. Scope / on purpose:
    a directory scope (a project's working copy may carry its own Doppler
    scope for the project's secrets) must never decide an identity's config."""
    try:
        r = subprocess.run(["doppler", "configure", "get", "enclave.config", "--plain", "--scope", "/"],
                           capture_output=True, text=True)
    except FileNotFoundError:
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""


HOME = os.environ.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir
SOURCE_FILE = os.path.join(HOME, ".config", "agent-fabric", "secrets-source")


def configured_source():
    """`store` once this account's secrets have moved to its own store
    (ADR-038), `doppler` before: an absent or unreadable file is doppler."""
    try:
        v = open(SOURCE_FILE, encoding="utf-8").read().strip()
    except OSError:
        return "doppler"
    return v if v in ("doppler", "store") else "doppler"


SOURCE = configured_source()


def load_store():
    import importlib.util
    spec = importlib.util.spec_from_file_location("fabric_secret_store", os.path.join(ROOT, "tools", "fabric", "secret_store.py"))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


if SOURCE == "store":
    PROJECT, CONFIG = "store", os.environ.get("AGENT_FABRIC_SECRET_STORE") or os.path.join(
        HOME, ".local", "share", "agent-fabric", "secrets")
else:
    CONFIG = os.environ.get("AGENT_FABRIC_SECRETS_CONFIG") or configured_config() or f"agents_{LOGIN}"
ENV_FILE = os.path.join(HOME, ".config", "agent-fabric", "secrets.env")
BASHRC = os.path.join(HOME, ".bashrc")
SSH_KEY = os.path.join(HOME, ".ssh", "id_ed25519")
MARKER = "# agent-fabric secrets"
SOURCE_LINE = f"[ -r {ENV_FILE} ] && . {ENV_FILE}  {MARKER}" if " " not in ENV_FILE \
    else f"[ -r {shlex.quote(ENV_FILE)} ] && . {shlex.quote(ENV_FILE)}  {MARKER}"

ENV_NAMES = ["OPENROUTER_API_KEY", "GH_TOKEN", "CLAUDE_BRIDGE_AUTH_TOKEN"]


def project_agent_env():
    """Names the registry declares as per-agent environment — fabric-wide
    (top-level `agent_env`) or per project (`projects.<id>.agent_env`):
    secrets a script reads directly (OPENAI_API_KEY), or values that
    belong to the login rather than to a clone — a project's per-login port
    offset, whose per-clone home (a table keyed by the clone's basename)
    stopped meaning anything once every clone was named after its project.
    Exported when the config has them; their absence is never a missing name."""
    try:
        reg = json.load(open(os.path.join(ROOT, "projects", "registry.json"), encoding="utf-8"))
    except (OSError, ValueError):
        return []
    names = []
    # Fabric-wide names first (registry top-level agent_env), then each project's.
    for holder in [reg, *((reg.get("projects") or {}).values())]:
        for n in (holder.get("agent_env") or {}):
            if n not in names and n not in ENV_NAMES:
                names.append(n)
    return names


OPTIONAL_ENV_NAMES = project_agent_env()
GIT_NAMES = {"GIT_USER_NAME": "user.name", "GIT_USER_EMAIL": "user.email",
             "GIT_SIGNING_KEY": "user.signingkey", "GIT_GPG_PROGRAM": "gpg.program"}
SSH_NAMES = ["SSH_PRIVATE_KEY", "SSH_PUBLIC_KEY"]
IDENTITY_NAMES = ["AGENT_LOGIN", "AGENT_HOST"]
ALL_NAMES = IDENTITY_NAMES + ENV_NAMES + list(GIT_NAMES) + SSH_NAMES
KNOWN_NAMES = ALL_NAMES + OPTIONAL_ENV_NAMES


def usage(code=2):
    print("usage: fabric-secrets sync [--force] [--json] [--quiet] | status [--json]", file=sys.stderr)
    sys.exit(code)


def doppler(*args, stdin=None):
    """Run the doppler CLI for THIS login's config; stdout captured, never echoed."""
    cmd = ["doppler", *args, "--project", PROJECT, "--config", CONFIG]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, input=stdin)
    except FileNotFoundError:
        return None, "doppler CLI not on PATH"
    if r.returncode != 0:
        lines = (r.stderr or r.stdout).strip().splitlines()
        return None, (lines[-1] if lines else f"doppler exit {r.returncode}")
    return r.stdout, None


def token_configured():
    try:
        r = subprocess.run(["doppler", "configure", "get", "token", "--plain"], capture_output=True, text=True)
    except FileNotFoundError:
        return False
    return r.returncode == 0 and bool(r.stdout.strip())


def git_get(key):
    r = subprocess.run(["git", "config", "--global", "--get", key], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def git_set(key, value):
    subprocess.run(["git", "config", "--global", key, value], check=True)


def write_private(path, content, mode):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, "w") as fh:
        fh.write(content)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def file_mode(path):
    try:
        return stat.S_IMODE(os.stat(path).st_mode)
    except FileNotFoundError:
        return None


def bashrc_has_line():
    try:
        return any(MARKER in line for line in open(BASHRC, encoding="utf-8"))
    except FileNotFoundError:
        return False


def local_state():
    mode = file_mode(ENV_FILE)
    age = None
    if mode is not None:
        age = int(time.time() - os.stat(ENV_FILE).st_mtime)
    exported = []
    if mode is not None:
        for line in open(ENV_FILE, encoding="utf-8"):
            if line.startswith("export ") and "=" in line:
                exported.append(line[len("export "):].split("=", 1)[0])
    return {
        "env_file": ENV_FILE, "env_file_mode": (f"{mode:04o}" if mode is not None else None),
        "env_file_age_seconds": age, "env_file_exports": exported,
        "bashrc_sources_env_file": bashrc_has_line(),
        "ssh_key_present": os.path.exists(SSH_KEY),
        "git": {key: bool(git_get(key)) for key in GIT_NAMES.values()},
        "commit_gpgsign": git_get("commit.gpgsign") == "true",
        "doppler_token_configured": token_configured(),
    }


def fetch_names():
    if SOURCE == "store":
        try:
            return load_store().names(), None
        except Exception as e:  # noqa: BLE001 — reported as the store's error, never a value
            return None, f"store: {e}"
    out, err = doppler("secrets", "--only-names", "--json")
    if err:
        return None, err
    try:
        data = json.loads(out)
    except ValueError:
        return None, "doppler returned no JSON"
    names = list(data.keys()) if isinstance(data, dict) else [d.get("name") for d in data if isinstance(d, dict)]
    return [n for n in names if n and not n.startswith("DOPPLER_")], None


def fetch_values():
    if SOURCE == "store":
        try:
            st = load_store()
            note = st.pull()
            vals = st.values()
        except Exception as e:  # noqa: BLE001 — the store's error, never a value
            return None, f"store: {e}"
        if note:
            print(f"fabric-secrets: {note}; the local copy was read", file=sys.stderr)
        return vals, None
    out, err = doppler("secrets", "download", "--no-file", "--format", "json")
    if err:
        return None, err
    try:
        data = json.loads(out)
    except ValueError:
        return None, "doppler returned no JSON"
    if not isinstance(data, dict):
        return None, "doppler returned an unexpected shape"
    return {k: v for k, v in data.items() if not k.startswith("DOPPLER_") and isinstance(v, str)}, None


QUIET = False


def report(obj, as_json, ok):
    if QUIET:
        # For a shell entry (moveto): silence when all is well, one line otherwise.
        if not ok:
            what = obj.get("error") or f"missing in {'the store' if SOURCE == 'store' else 'Doppler'}: {', '.join(obj.get('missing', []))}"
            print(f"fabric-secrets: {what}", file=sys.stderr)
        return
    if as_json:
        print(json.dumps(obj, indent=2, sort_keys=True))
        return
    print(f"fabric-secrets: login={obj['login']} project={obj['project']} config={obj['config']}")
    if obj.get("error"):
        print(f"  error: {obj['error']}")
    if "present" in obj:
        print(f"  present: {', '.join(obj['present']) or '(none)'}")
        print(f"  missing: {', '.join(obj['missing']) or '(none)'}")
    if "applied" in obj:
        print(f"  applied: {', '.join(obj['applied']) or '(none)'}")
        if obj.get("skipped"):
            print(f"  skipped: {', '.join(obj['skipped'])}")
    ls = obj["local"]
    env = f"{ls['env_file']} mode={ls['env_file_mode']} age={ls['env_file_age_seconds']}s exports={','.join(ls['env_file_exports'])}" \
        if ls["env_file_mode"] else f"{ls['env_file']} (absent)"
    print(f"  env file: {env}")
    print(f"  bashrc sources it: {ls['bashrc_sources_env_file']}   ssh key: {ls['ssh_key_present']}   "
          f"git: {', '.join(k for k, v in ls['git'].items() if v) or '(unset)'}   commit.gpgsign: {ls['commit_gpgsign']}   "
          f"doppler token: {ls['doppler_token_configured']}")
    print("  " + ("OK" if ok else "NOT OK"))


def status(as_json):
    obj = {"login": LOGIN, "project": PROJECT, "config": CONFIG, "local": local_state()}
    names, err = fetch_names()
    ok = True
    if err:
        obj["error"] = err
        ok = False
    else:
        obj["present"] = [n for n in ALL_NAMES if n in names]
        obj["missing"] = [n for n in ALL_NAMES if n not in names]
        obj["optional"] = [n for n in OPTIONAL_ENV_NAMES if n in names]
        obj["unexpected"] = sorted(n for n in names if n not in KNOWN_NAMES)
        ok = not obj["missing"]
    ok = ok and obj["local"]["env_file_mode"] == "0600" and obj["local"]["bashrc_sources_env_file"]
    report(obj, as_json, ok)
    return 0 if ok else 1


def sync(force, as_json):
    obj = {"login": LOGIN, "project": PROJECT, "config": CONFIG, "applied": [], "skipped": []}
    values, err = fetch_values()
    if err:
        obj["error"] = err
        obj["local"] = local_state()
        report(obj, as_json, False)
        return 1
    obj["present"] = [n for n in ALL_NAMES if n in values]
    obj["missing"] = [n for n in ALL_NAMES if n not in values]
    obj["optional"] = [n for n in OPTIONAL_ENV_NAMES if n in values]
    obj["unexpected"] = sorted(n for n in values if n not in KNOWN_NAMES)
    # The invariant, enforced: a config that does not name this login is
    # someone else's, whatever token reached it.
    if values.get("AGENT_LOGIN") != LOGIN:
        obj["error"] = (f"config {CONFIG} names AGENT_LOGIN={values.get('AGENT_LOGIN') or '(unset)'}, "
                        f"this login is {LOGIN}; nothing applied")
        obj["local"] = local_state()
        report(obj, as_json, False)
        return 3
    # 1. the env file — only the names the tools read from the environment
    lines = [f"{MARKER}: written by fabric-secrets sync, {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}; do not edit"]
    for name in ENV_NAMES + OPTIONAL_ENV_NAMES:
        if name in values:
            lines.append(f"export {name}={shlex.quote(values[name])}")
            obj["applied"].append(name)
    write_private(ENV_FILE, "\n".join(lines) + "\n", 0o600)
    # 2. ~/.bashrc sources it (once)
    if not bashrc_has_line():
        with open(BASHRC, "a", encoding="utf-8") as fh:
            fh.write(f"\n{SOURCE_LINE}\n")
        obj["applied"].append("bashrc")
    # 3. git identity and signing — strings, not key material
    for name, key in GIT_NAMES.items():
        if name in values:
            git_set(key, values[name])
            obj["applied"].append(name)
    if "GIT_SIGNING_KEY" in values:
        git_set("commit.gpgsign", "true")
        git_set("tag.gpgsign", "true")
    # 4. the SSH key — never silently replace one that is already there
    if "SSH_PRIVATE_KEY" in values:
        if os.path.exists(SSH_KEY) and not force:
            obj["skipped"].append("SSH_PRIVATE_KEY (present; --force replaces)")
        else:
            priv = values["SSH_PRIVATE_KEY"].rstrip("\n") + "\n"
            write_private(SSH_KEY, priv, 0o600)
            obj["applied"].append("SSH_PRIVATE_KEY")
            if "SSH_PUBLIC_KEY" in values:
                write_private(SSH_KEY + ".pub", values["SSH_PUBLIC_KEY"].rstrip("\n") + "\n", 0o644)
                obj["applied"].append("SSH_PUBLIC_KEY")
    obj["local"] = local_state()
    ok = not obj["missing"]
    report(obj, as_json, ok)
    return 0 if ok else 2


if not ARGS or ARGS[0] in ("-h", "--help"):
    usage(0 if ARGS else 2)
cmd, flags = ARGS[0], ARGS[1:]
unknown = [f for f in flags if f not in ("--force", "--json", "--quiet")]
if unknown:
    usage()
as_json = "--json" in flags
QUIET = "--quiet" in flags
if cmd == "status":
    sys.exit(status(as_json))
if cmd == "sync":
    sys.exit(sync("--force" in flags, as_json))
usage()
PY
