#!/usr/bin/env bash
# runtime/provisioning/secrets/fabric-secrets — an identity's secrets, from
# its own store (ADR-038), into the places the tools read them. Runs AS THE
# ACCOUNT. The path is the contract (bin/fabric-secrets, moveto, the control
# agent call it); the work is Python:
#
#   fabric-secrets sync|status …   tools/fabric/secrets_sync.py
#   fabric-secrets store …         tools/fabric/secret_store.py
#   fabric-secrets provision …     tools/fabric/store_provision.py (a parent fills its children's stores)
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd)"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-secrets: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
case "${1:-}" in
    store) shift; exec "$py" "$ROOT/tools/fabric/secret_store.py" "$@" ;;
    provision) shift; exec "$py" "$ROOT/tools/fabric/store_provision.py" "$@" ;;
esac
exec "$py" "$ROOT/tools/fabric/secrets_sync.py" "$@"
