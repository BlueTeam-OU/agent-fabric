{
  "version": 1,
  "project": "agent-fabric",
  "note": "Binding rules for agent-fabric as a managed repository of its own. The whole control plane, protocol text included, is fabric-coordinator's, and python-dev contributes the code of its port to Python (ADR-018 §5 rule 8); distilled project knowledge under memory/projects/<id>/ is that project's roles' work and is not bound here.",
  "projects": {
    "include": [
      "agent-fabric"
    ],
    "exclude": [],
    "unattributed_bucket": "observer-sessions"
  },
  "reattribution": {
    "path_markers": {
      "include": [
        "projects/agent-fabric"
      ],
      "exclude": []
    },
    "keywords": {
      "include": [
        "agent-fabric",
        "fabric-whoami",
        "fabric-status",
        "capability class",
        "review-grade",
        "gzcoord"
      ],
      "exclude": []
    }
  },
  "roles": [
    {
      "id": "fabric-coordinator",
      "paths": [
        "identities/",
        "routing/",
        "policies/",
        "runtime/",
        "projects/",
        "communication/",
        "tools/fabric/",
        "tests/",
        "docs/"
      ],
      "keywords": [
        "control plane",
        "identity invariant",
        "routing",
        "shim",
        "charter",
        "authority",
        "gzcoord",
        "GZCOORD/1",
        "message format",
        "conformance"
      ],
      "types": [
        "decision"
      ]
    },
    {
      "id": "python-dev",
      "paths": [
        "tools/fabric/",
        "tests/",
        "bin/",
        "runtime/github/",
        "runtime/openrouter/",
        "runtime/provisioning/"
      ],
      "keywords": [
        "python",
        "port",
        "oracle",
        "shim",
        "subprocess",
        "stdlib",
        "bash allowlist"
      ],
      "types": [
        "solution",
        "workflow"
      ]
    }
  ]
}
