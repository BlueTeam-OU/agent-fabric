#!/usr/bin/env bash
# bin/fabric-history — what this agent said and was told, from its own
# episodic journal (agent-fabric ADR-041). The path is the contract
# (~/.local/bin/fabric-history links here); the work is
# tools/fabric/history.py. Bash builtins only: the command is reached through
# a symlink, which python resolves.
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-history: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" -I -c '
import os, runpy, sys
here = os.path.dirname(os.path.realpath(sys.argv[1]))
module = os.path.join(here, "..", "tools", "fabric", "history.py")
sys.argv[:2] = [module]
runpy.run_path(module, run_name="__main__")
' "${BASH_SOURCE[0]}" "$@"
