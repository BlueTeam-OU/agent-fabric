#!/usr/bin/env bash
# bin/fabric-host — the coordinator's door to the hosts the agents live on.
# The path is the contract (the coordinator, moveto and the provisioning
# workers run it); the work, its contract and every reason for it are in
# tools/fabric/fabric_host.py (ADR-040 §5 rule 4).
#
#   fabric-host list | <host> check | <host> run [--as <login>] [--tty] -- <cmd>...
#   fabric-host <host> moveto|rename|persist|drain ... | ssh-pin <login>      (fabric-host --help)
#
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-host: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" -I "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../tools/fabric/fabric_host.py" "$@"
