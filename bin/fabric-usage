#!/usr/bin/env bash
# bin/fabric-usage — the fleet's Claude usage windows, one line per placed
# account, through the host executor: the fallback for a host whose
# control agents are down (`fabric-ctl all usage` otherwise). The path is
# the contract (runtime/claude-code/commands.json); the work, its rules
# and every reason for them are in tools/fabric/usage.py (ADR-040 Wave 3).
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-usage: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$ROOT/tools/fabric/usage.py" "$@"
