#!/usr/bin/env bash
# bin/fabric-status — one call, the whole picture: who this session is,
# what it is bound to, which API path it runs on, and how the capability
# classes resolve there. The path is the contract (~/.local/bin/fabric-status
# links here); the work, its contract and every reason for it are in
# tools/fabric/status.py (ADR-040 §5 rule 4).
#
#   agent-fabric/bin/fabric-status            # human-readable
#   agent-fabric/bin/fabric-status --json     # the same, as one object
#
# Bash builtins only, to find the module: the command is reached through a
# symlink, which no builtin can follow, so python resolves it — with git or
# hostname missing from PATH the report must still run, and say which.
exec /usr/bin/python3 -I -c '
import os, runpy, sys
here = os.path.dirname(os.path.realpath(sys.argv[1]))
module = os.path.join(here, "..", "tools", "fabric", "status.py")
sys.argv[:2] = [module]
runpy.run_path(module, run_name="__main__")
' "${BASH_SOURCE[0]}" "$@"
