#!/usr/bin/env bash
# bin/fabric-jobs — this agent's job list: what it has undertaken, is
# doing, waits on and has delivered (agent-fabric ADR-037).
#
#   fabric-jobs add "<title>" [--topic T] [--project P] [--working-copy W]
#   fabric-jobs list [--all]
#   fabric-jobs start|done <id>;  block <id> "<on what>";  drop <id> "<why>"
#   fabric-jobs deliver <id> <artifact>...
#   fabric-jobs show <id>
#   fabric-jobs next [<id>]     # start the next job: continue here, or run fabric-fresh --job
#
# The full account is in tools/fabric/jobs.py.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export AGENT_FABRIC_ROOT="${AGENT_FABRIC_ROOT:-$ROOT}"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-jobs: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$ROOT/tools/fabric/jobs.py" "$@"
