#!/usr/bin/env bash
# bin/fabric-lease — run a command under a host-wide lease (ADR-010). The
# path is the contract (the control plane, the launcher's callers and the
# agents' procedures name it); the work, its rules and every reason for
# them are in tools/fabric/lease.py (ADR-040 §5 rule 4). Bash builtins
# only, and `exec` so the wrapper is the one process the caller signals
# and waits for: its signals, its pid in the lease record and its exit
# status are the Python's. It is run through a symlink (~/.local/bin), and
# no builtin resolves one, so the module is found by Python: -I keeps the
# caller's directory and PYTHONPATH out of the import path of a program
# that runs in any working copy. SIGPIPE ignored on entry is handed over in
# the environment because Python resets it at start-up.
unset _FABRIC_LEASE_PIPE_IGNORED
[[ "$(trap -p PIPE)" == *"''"* ]] && export _FABRIC_LEASE_PIPE_IGNORED=1
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-lease: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" -I -c 'import os, runpy, sys
m = os.path.join(os.path.dirname(os.path.realpath(sys.argv[1])), "..", "tools", "fabric", "lease.py")
sys.argv = [m, *sys.argv[2:]]
runpy.run_path(m, run_name="__main__")' "${BASH_SOURCE[0]}" "$@"
