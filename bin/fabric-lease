#!/usr/bin/env bash
# bin/fabric-lease — run a command under a host-wide lease: one holder at
# a time across every account on this host, by name.
#
#   fabric-lease <name> [--wait SECS] [--need-mem MB] [--label JOB] -- <cmd> [args...]
#   fabric-lease <name> --who              who holds it, if anyone; exit 0 free, 1 held
#
# The host is one machine the accounts share, and some of what they run
# is a host resource, not an account's: a backend integration suite with
# its own postgres, a device emulator, a build that takes every core.
# Two of those at once is how develop-qzapp died on 2026-09-19 — two
# accounts started the backend suite forty seconds apart on a VM
# ballooned to 8.6 GiB, 166,000 postgres files in ninety seconds, and
# the VM was gone (docs/live-checks/2026-09-19-develop-qzapp-crash.md).
# The fix is not a role that runs suites for everyone: it is mutual
# exclusion where the suite is started (ADR-010).
#
# A lease is a flock(2) on ${AGENT_FABRIC_LEASES:-/run/lock/agent-fabric}/<name>,
# a directory every account can create files in (1777, made at boot by
# the account boot script on a Qubes AppVM and by tmpfiles.d elsewhere,
# both installed by runtime/provisioning/persist-accounts.sh). The file is
# created 0666 so the holder — whichever account it is — can write one
# line into it: `<login> <pid> <since> <name>`, which is what a refused
# caller is told. The kernel releases the lock when the holder exits,
# however it exits: a killed suite leaves no stale lease.
#
# Fail fast by default: a session's tool call has a timeout of its own
# and should decide, told who holds the lease, whether to wait, do
# something else or ask; --wait SECS blocks that long first. --need-mem
# refuses, lease released, when MemAvailable is under MB — the balloon
# on a Qubes VM grows on demand with a lag, and a suite started at 8.6
# GiB does not get its 18 before it needs them. The command runs with
# the lease's descriptor closed, so nothing it spawns and leaves behind
# keeps the lease. Exit status: the command's; 75 (EX_TEMPFAIL) when
# the lease is held or memory is short; 2 on a usage error, a missing
# lease directory, an unopenable lease file or unreadable memory.
#
# Every refusal ends with ONE stable line on stderr, the contract a caller
# matches instead of the prose above it (ADR-010):
#   fabric-lease: reason=memory|memory-unknown|timeout|held|nodir|unopenable
# (a usage error — bad arguments, exit 2, before any lease file is
# touched — carries none.)
# --label names the JOB under the lease (the lease names the resource):
# it rides in the holder's record, so "heavy" held by a suite says so.
set -uo pipefail
LEASES="${AGENT_FABRIC_LEASES:-/run/lock/agent-fabric}"
MEMINFO="${AGENT_FABRIC_MEMINFO:-/proc/meminfo}"
usage() {
    cat >&2 <<'U'
usage: fabric-lease <name> [--wait SECS] [--need-mem MB] [--label JOB] -- <cmd> [args...]
       fabric-lease <name> --who              who holds it, if anyone; exit 0 free, 1 held
U
    exit 2
}
NAME=""; WAIT=0; NEED=0; WHO=0; LABEL=""
# The machine-readable reason, always the last line of a refusal.
refuse() { local code="$1" reason="$2"; shift 2; [[ $# -gt 0 ]] && echo "fabric-lease: $*" >&2; echo "fabric-lease: reason=$reason" >&2; exit "$code"; }
while [[ $# -gt 0 ]]; do
    case "$1" in
        --wait) WAIT="${2:-}"; shift ;;
        --wait=*) WAIT="${1#--wait=}" ;;
        --need-mem) NEED="${2:-}"; shift ;;
        --need-mem=*) NEED="${1#--need-mem=}" ;;
        --label) LABEL="${2:-}"; shift ;;
        --label=*) LABEL="${1#--label=}" ;;
        --who) WHO=1 ;;
        --) shift; break ;;
        -*) echo "fabric-lease: unknown option $1" >&2; usage ;;
        *) [[ -z "$NAME" ]] && NAME="$1" || { echo "fabric-lease: one name, then --" >&2; usage; } ;;
    esac
    shift
done
[[ -n "$NAME" ]] || usage
[[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || { echo "fabric-lease: a name is [A-Za-z0-9._-], 64 at most: '$NAME'" >&2; exit 2; }
[[ "$WAIT" =~ ^[0-9]+$ && "$NEED" =~ ^[0-9]+$ ]] || { echo "fabric-lease: --wait and --need-mem take whole numbers" >&2; exit 2; }
# A label is written into a file every account reads and printed to
# every refused caller: a token, no spaces, no control characters.
[[ -z "$LABEL" || "$LABEL" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || { echo "fabric-lease: a label is [A-Za-z0-9._-], 64 at most: '$LABEL'" >&2; exit 2; }
(( WHO )) || [[ $# -ge 1 ]] || { echo "fabric-lease: a command after --" >&2; usage; }
# An agent has no sudo: the directory is root's to make (the boot script,
# tmpfiles.d, or the operator's persist run), so the message names whose
# action it is rather than a command the caller cannot run.
[[ -d "$LEASES" ]] || refuse 2 nodir "no lease directory at $LEASES — it is made at boot by the fabric's provisioning; ask the host's operator (fabric-coordinator) to run bin/fabric-host <host> persist"
L="$LEASES/$NAME"
# 0666 so a later holder, another login, can record itself; a file that
# exists with tighter modes (made by hand) still locks, and the record is
# best effort. The lock is taken on a READ-ONLY descriptor and the record
# written by dd with conv=nocreat: in a sticky world-writable directory
# fs.protected_regular (systemd's default is 1 — /usr/lib/sysctl.d/50-default.conf;
# some distributions set 2; the mechanism needs only >= 1) refuses an O_CREAT open of a file
# another login owns, and every bash write redirection carries O_CREAT —
# found live on develop-qzapp, 2026-09-19, the second account locked out
# of the first one's lease file (docs/live-checks/2026-09-19-develop-qzapp-crash.md).
[[ -e "$L" ]] || ( umask 000; : >> "$L" ) 2>/dev/null
exec 9<"$L" || refuse 2 unopenable "cannot open $L"
holder() { local h; h="$(head -c 512 "$L" 2>/dev/null | head -1 | LC_ALL=C tr -cd '\040-\176')"; [[ -n "$h" ]] && echo "$h" || echo "(holder unrecorded)"; }
record() { [[ -w "$L" ]] && printf '%s %s %s %s%s\n' "$(id -un)" "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$NAME" "${LABEL:+ ($LABEL)}" | dd of="$L" conv=nocreat status=none 2>/dev/null; return 0; }
# A probe is a SHARED lock, never the exclusive one: `flock -n` on a free
# lease would take it for the probe's lifetime, and sixteen daemons
# probing at once (fabric-ctl all host) or a --who could refuse a real
# caller and report a stale record as the holder (the whole-range review
# of b981d19, F1). Shared locks coexist, so two probes never see each
# other; a holder's exclusive lock refuses a shared probe, which is the
# answer "held".
if (( WHO )); then
    if flock -s -n 9; then echo "free: $NAME"; exit 0; fi
    echo "held: $(holder)"; exit 1
fi
# The real caller waits a bounded second before refusing: long enough
# to outlive any probe's momentary hold, far shorter than any real
# holder's seconds-to-minutes, so "fail fast" holds to within a second.
if ! flock -w 1 9; then
    h="$(holder)"
    if (( WAIT > 0 )); then
        echo "fabric-lease: $NAME is held by $h — waiting up to ${WAIT}s" >&2
        flock -w "$WAIT" 9 || refuse 75 timeout "$NAME still held by $(holder) after ${WAIT}s"
    else
        refuse 75 held "$NAME is held by $h — retry later, or --wait SECS"
    fi
fi
# Held. The record FIRST: a caller refused while this one is still
# checking memory must read this holder, not the previous one (F3).
record
# Held. Memory, checked under the lease so two callers do not both pass.
if (( NEED > 0 )); then
    avail_kb="$(awk '/^MemAvailable:/{print $2}' "$MEMINFO" 2>/dev/null)"
    # A floor that cannot be evaluated is refused, never skipped.
    [[ "$avail_kb" =~ ^[0-9]+$ ]] || refuse 2 memory-unknown "--need-mem asked, and MemAvailable cannot be read from $MEMINFO"
    if (( avail_kb / 1024 < NEED )); then
        total_kb="$(awk '/^MemTotal:/{print $2}' "$MEMINFO" 2>/dev/null)"; [[ "$total_kb" =~ ^[0-9]+$ ]] || total_kb=0
        echo "fabric-lease: $NAME needs ${NEED} MB and this host has $((avail_kb / 1024)) MB available (MemTotal $((total_kb / 1024)) MB) — the largest processes:" >&2
        ps -eo user:20,pid,rss,comm --sort=-rss 2>/dev/null | head -6 | awk 'NR==1{print "   "$0; next}{printf "   %-20s %7s %6d MB %s\n", $1, $2, $3/1024, $4}' >&2
        refuse 75 memory
    fi
fi
# The command runs in ITS OWN PROCESS GROUP (set -m around the fork),
# with the lease's descriptor closed, and TERM, INT and HUP delivered
# to the wrapper are forwarded to that whole group — a wrapper killed
# alone would otherwise release the lease while the suite, and its
# postgres, were still running (the re-review of 1fbed3d reproduced
# exactly that with the first shape of this: a trap that forwarded to
# the direct child only, then `wait` returning at once with 143). Job
# control is what gives the child default signal dispositions and the
# wrapper's stdin: a plain `&` in a script hands it /dev/null and INT
# and QUIT ignored, which every descendant inherits. The cost: the
# child is not the terminal's foreground group, so a command that READS
# THE TTY is stopped with SIGTTIN — not a case for a suite started from
# a tool call, and the reason interactive use is not what this is for.
# `wait` returns early (128+signal) when a trapped signal arrives, so it
# is repeated until the child is really gone: the lease is held through
# the suite's teardown and the exit status is the command's. `command
# --` so a name never resolves to a function of this script nor to an
# option of `command` itself.
# The traps are armed BEFORE the fork: a signal in the gap between the
# fork and the trap would kill the wrapper with the default disposition,
# release the lease, and leave the command running in its own group —
# the outcome this design exists to prevent (F2). Before the child
# exists a signal is only remembered, and forwarded once it does.
child=""; pending=""; hit=0
forward() { hit=1; if [[ -n "$child" ]]; then kill -"$1" -- "-$child" 2>/dev/null; else pending="$1"; fi; }
trap 'forward TERM' TERM
trap 'forward INT' INT
trap 'forward HUP' HUP
set -m
command -- "$@" 9>&- &
child=$!
set +m
[[ -n "$pending" ]] && forward "$pending"
# `wait` returns 128+signal the moment a trapped signal arrives; the
# command is still running. Repeat until a wait completed with no signal
# in between — a flag set by the trap, not `kill -0`, which can race the
# shell's own reaping of the child and report it gone before its status
# was collected.
while :; do hit=0; wait "$child"; rc=$?; (( hit )) || break; done
trap - TERM INT HUP
exit "$rc"
