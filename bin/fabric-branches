#!/usr/bin/env bash
# bin/fabric-branches — local branch hygiene (ADR-022). The path is the
# contract (commands.json, the session-start hook's advice, the agents'
# procedures name it); the work, its rules and every reason for them are in
# tools/fabric/branches.py (ADR-040 §5 rule 4). Bash builtins only, to find
# it: with git or hostname missing from PATH the module must still run, and
# say which. It is reached through a symlink in ~/.local/bin, which no bash
# builtin resolves, so Python does: the real path of this file, the module
# beside its bin/.
exec /usr/bin/python3 -c 'import os, runpy, sys
real = os.path.realpath(sys.argv[1])
module = os.path.join(os.path.dirname(os.path.dirname(real)), "tools", "fabric", "branches.py")
sys.argv = [module] + sys.argv[2:]
runpy.run_path(module, run_name="__main__")' "${BASH_SOURCE[0]}" "$@"
