#!/usr/bin/env python3
"""bin/gzmsg — the command the docs, hooks and sessions name
(~/.local/bin/gzmsg links here). The tool is tools/fabric/gzcoord/gzmsg.py;
tools/fabric/gzcoord/entry.py hands over to the pinned Python and keeps the
last-resort contract: exit 1 when nothing can start, one line, no stack
trace."""
import os
import runpy
import sys

try:
    ENTRY = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "tools", "fabric", "gzcoord", "entry.py")
    launch = runpy.run_path(ENTRY)["launch"]
except Exception as e:
    print("gzmsg: %s" % e, file=sys.stderr)
    sys.exit(1)
launch("gzmsg", sys.argv[0])
