#!/usr/bin/env bash
# bin/fabric-pr — the GitHub toolkit's one command (agent-fabric ADR-040 §5
# rule 7). A forwarder: the verb table, the help and the refusal of an unknown
# verb are tools/fabric/github/fabric_pr.py (ADR-040 Wave 9).
#
#   fabric-pr gate|review-status|post-review|reply|arm|sessions|
#             trial-merge|wait-merged|owed-supply|compliance|counts  [args…]
#   fabric-pr help          # the verbs; so does no verb
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# readlink and dirname are not builtins: with them missing ROOT collapses
# to "/", and the failure would be a file not found under it.
[[ -d "$ROOT/tools/fabric/github" ]] || { echo "fabric-pr: cannot locate the checkout (readlink or dirname missing from PATH?)" >&2; exit 127; }
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-pr: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$ROOT/tools/fabric/github/fabric_pr.py" "$@"
