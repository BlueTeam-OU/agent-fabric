#!/usr/bin/env bash
# bin/fabric-gh-ledger — what the fabric spends of the GitHub quota. The path is the
# contract once fabric-coordinator registers it in commands.json (it is not yet); the work, its rules and
# every reason for them are in
# tools/fabric/gh_ledger.py (ADR-040 §5 rule 4). Bash builtins only, to find
# it: with git or hostname missing from PATH the module must still run, and
# say which. Once registered it is reached through a symlink in ~/.local/bin, which no bash
# builtin resolves, so Python does: the real path of this file, the module
# beside its bin/.
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-gh-ledger: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" -I -c 'import os, runpy, sys
real = os.path.realpath(sys.argv[1])
module = os.path.join(os.path.dirname(os.path.dirname(real)), "tools", "fabric", "gh_ledger.py")
sys.argv = [module] + sys.argv[2:]
runpy.run_path(module, run_name="__main__")' "${BASH_SOURCE[0]}" "$@"
