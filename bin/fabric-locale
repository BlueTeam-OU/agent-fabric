#!/usr/bin/env bash
# bin/fabric-locale — what a locale's translator needs from the fabric.
#
#   fabric-locale tokens <source.md>   the protected tokens of an English source: every
#                                      identifier a translation keeps byte-identical, with
#                                      its count (tools/fabric/lint.py checks the same list)
#   fabric-locale digest <source.md>   the source's body digest, what the translation's
#                                      frontmatter records as translates_digest
#
# A forwarder: the verbs and their usage are tools/fabric/fabric_locale.py
# (docs/adr/ADR-027-language-and-culture-shape-the-work-the-bridge.md).
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-locale: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$ROOT/tools/fabric/fabric_locale.py" "$@"
