#!/usr/bin/env bash
# bin/fabric-repo-policy — a repository's arming policy against what GitHub holds (arming step C):
#
#   fabric-repo-policy plan   [owner/repo] [--json]   the differences GitHub would need changed, or "no change"
#   fabric-repo-policy verify [owner/repo] [--json]   exit 1 when GitHub differs from the policy, 2 when unreadable
#
# The full account is in tools/fabric/github/repo_policy.py.
set -uo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# readlink and dirname are not builtins: with them missing ROOT collapses
# to "/", and the failure would be a file not found under it.
[[ -d "$ROOT/tools/fabric" ]] || { echo "fabric-repo-policy: cannot locate the checkout (readlink or dirname missing from PATH?)" >&2; exit 127; }
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-repo-policy: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$ROOT/tools/fabric/github/repo_policy.py" "$@"
