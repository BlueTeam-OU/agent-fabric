#!/usr/bin/env bash
# bin/fabric-watch — this account's status, jobs and open pull requests,
# kept current until q: the status pane of Fleet Deck's tab (moveto
# <account> --watch). The work and its contract are in tools/fabric/watch.py.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export AGENT_FABRIC_ROOT="${AGENT_FABRIC_ROOT:-$ROOT}"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-watch: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$ROOT/tools/fabric/watch.py" "$@"
