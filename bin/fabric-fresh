#!/usr/bin/env bash
# bin/fabric-fresh — end this session at the end of a job and let the
# launcher start a fresh one (agent-fabric ADR-022). The path is the
# contract (runtime/claude-code/commands.json, fabric-jobs next); the work,
# its rules and every reason for them are in tools/fabric/fresh.py
# (ADR-040 Wave 3). The module walks up from its own process to the
# session, so this execs it: no shell is left between them.
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-fresh: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
exec "$py" "$ROOT/tools/fabric/fresh.py" "$@"
