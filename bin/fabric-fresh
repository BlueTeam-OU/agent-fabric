#!/usr/bin/env bash
# bin/fabric-fresh — end this session at the end of a job and let the
# launcher start a fresh one: the agent's own /clear (agent-fabric ADR-022).
#
#   fabric-fresh [--note "<one line for the next session>"] [--job <id>] [--force]
#
# A slash command is the person's, never the model's, so an agent cannot
# /clear itself. It can end its own session: the session is the launcher's
# child (runtime/openrouter/launch), which waits on it, reads the restart
# marker this writes, and relaunches with no --resume — a new conversation
# in the same terminal, with the note in its opening prompt. The finished
# conversation stays on disk; `claude --resume` can still open it.
#
# --job <id> names the job the next session is for (`fabric-jobs next`
# prints it, ADR-022 rule 12): the launcher starts it in that job's working
# copy, with the job in its opening prompt. An unknown job is refused
# (exit 2); a working copy that is gone or has uncommitted changes is the
# launcher's to refuse, and it says so and starts in the old directory.
#
# Refused (exit 2) when the session was not started by the launcher —
# nothing would bring it back — and (exit 3) when the working copy has
# uncommitted changes, unless --force: a job that is not done has not
# reached its artifact. The stop is SIGTERM, the harness's graceful one.
# Exit 0 means the stop was sent; this process ends with the session.
# Refused too (exit 2) when the launch carried its own prompt or -p: the
# relaunch would replay it instead of starting anew; and when the
# session's launcher predates fabric-fresh: it would resume, not start
# anew — relaunch once; and when no claude process is above this one:
# there is no session to stop.
set -uo pipefail

note="" job="" force=0
while (( $# )); do
    case "$1" in
        --note) note="${2:-}"; shift 2 || { echo "fabric-fresh: --note needs a value" >&2; exit 2; } ;;
        --note=*) note="${1#--note=}"; shift ;;
        --job) job="${2:-}"; shift 2 || { echo "fabric-fresh: --job needs a job id" >&2; exit 2; } ;;
        --job=*) job="${1#--job=}"; shift ;;
        --force) force=1; shift ;;
        -h|--help) sed -n '2,/^[^#]/{/^#/p}' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "fabric-fresh: unknown argument '$1' (--note \"…\", --job <id>, --force)" >&2; exit 2 ;;
    esac
done

if [[ -z "${AGENT_FABRIC_LAUNCH_PROFILE:-}" ]]; then
    echo "fabric-fresh: this session was not started by the launcher, so nothing would start a fresh one; use /clear" >&2
    exit 2
fi
# Unset is a launcher older than fabric-fresh (an upgrade moves the
# checkout, never a running launcher): it cannot read a fresh marker.
case "${AGENT_FABRIC_LAUNCH_OPENING-unset}" in
    1) ;;
    unset)
        echo "fabric-fresh: this session's launcher predates fabric-fresh and would resume it, not start anew; relaunch once, or end it with /exit" >&2
        exit 2 ;;
    *)
        echo "fabric-fresh: this session was launched with its own prompt (or -p); a fresh launch would replay it, not start anew — end it with /exit" >&2
        exit 2 ;;
esac
FABRIC="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"
# The fleet's pinned Python (runtime/python.json, ADR-040), one per host;
# AGENT_FABRIC_PYTHON points elsewhere for a test or a host without it.
py="${AGENT_FABRIC_PYTHON:-/usr/local/bin/fabric-python}"
[[ -x "$py" ]] || { echo "fabric-fresh: the fleet's pinned Python is not installed at $py; as root: /usr/bin/python3 <agent-fabric>/tools/fabric/python_pin.py install" >&2; exit 127; }
if [[ -n "$job" ]] && ! AGENT_FABRIC_ROOT="$FABRIC" "$py" "$FABRIC/tools/fabric/jobs.py" show "$job" >/dev/null; then
    exit 2
fi
# Untracked files count: a new file never added is work not yet at its
# artifact, as much as an edit is (fabric-branches counts them too).
if (( ! force )) && git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
   && [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
    echo "fabric-fresh: $(git rev-parse --show-toplevel) has uncommitted changes; commit or stash them, or pass --force" >&2
    exit 3
fi

# The session is the nearest `claude` up this process's parent chain: the
# Bash tool runs as its descendant. AGENT_FABRIC_FRESH_COMM and _KILL exist
# for the suite, which runs inside a real session: it looks for a fake
# name and records the stop, so a test can never stop the session above it.
comm="${AGENT_FABRIC_FRESH_COMM:-claude}"
pid=$$ target=""
while [[ "$pid" =~ ^[0-9]+$ ]] && (( pid > 1 )); do
    if [[ "$(cat "/proc/$pid/comm" 2>/dev/null)" == "$comm" ]]; then target="$pid"; break; fi
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
done
if [[ -z "$target" ]]; then
    echo "fabric-fresh: no $comm process above this one; nothing to stop" >&2
    exit 2
fi

state="${AGENT_FABRIC_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-fabric}/agents/$(id -un)"
mkdir -p "$state" || exit 1
# requested_at a second ahead: the launcher obeys only a marker newer than
# its own start, and a job can end within the second the session began.
# Written through runtime/identity.py, like all per-agent state (ADR-003).
# The marker as written, kept to take it back only if it is still ours.
written="$("$py" -I - "$FABRIC" "$state/restart.json" "$note" "$job" <<'PY'

import importlib.util, os, sys
spec = importlib.util.spec_from_file_location("fabric_identity", os.path.join(sys.argv[1], "runtime", "identity.py"))
identity = importlib.util.module_from_spec(spec); spec.loader.exec_module(identity)
import datetime, json
path, note = sys.argv[2], " ".join(sys.argv[3].split())[:300]
at = (datetime.datetime.now(datetime.timezone.utc) + datetime.timedelta(seconds=1)).strftime("%Y-%m-%dT%H:%M:%SZ")
marker = {"requested_at": at, "piece": "a fresh session", "status": "done", "fresh": True, "note": note}
if sys.argv[4]:
    marker["job"] = sys.argv[4]
body = json.dumps(marker)
identity.atomic_write(path, body + "\n")
print(body)
PY
)" || exit 1
echo "fabric-fresh: ending this session; the launcher starts a fresh one${job:+ for job $job}${note:+ with: $note}" >&2
# A marker whose stop failed would turn the session's next plain exit
# into a fresh relaunch: take it back.
if ! "${AGENT_FABRIC_FRESH_KILL:-kill}" -TERM "$target"; then
    # Only our own marker: an upgrade may have written its own since.
    [[ "$(cat "$state/restart.json" 2>/dev/null)" == "$written" ]] && rm -f "$state/restart.json"
    echo "fabric-fresh: could not stop process $target; nothing changed" >&2
    exit 1
fi
